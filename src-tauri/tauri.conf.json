{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anima",
  "version": "0.4.0",
  "identifier": "dev.anima.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Anima memory server, in a desktop app",
    "copyright": "© 2026 Farid Naderi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "externalBin": [
      "binaries/anima-server"
    ],
    "resources": {
      "resources/server/": "server/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2ODY0RTc5QUJEQkZFNzcKUldSMy90dXJlVTZHcHM5d1JoU045Mi9STE1WeVdyNHl1Wmx6aC8zWFk4Wjk5My85eXFXODFWQkMK",
      "endpoints": [
        "https://github.com/Arizona-dev/anima-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
